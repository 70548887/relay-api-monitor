# Relay Lab launcher environment. Copy to /opt/relaylab/relaylab.env.
RELAYLAB_ADDR=127.0.0.1:42783
RELAYLAB_LAUNCHER_ADDR=127.0.0.1:42784
# Optional external configuration consumed by relaylab children.
RELAYLAB_CONFIG=/opt/relaylab/config.yaml
# Optional update credentials; never commit the populated file.
# RELAYLAB_UPDATE_GITHUB_TOKEN=
# RELAYLAB_UPDATE_PROXY=
