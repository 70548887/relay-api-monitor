[Unit]
Description=Relay Lab launcher (serve and worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relaylab
Group=relaylab
WorkingDirectory=/opt/relaylab
EnvironmentFile=-/opt/relaylab/relaylab.env
ExecStart=/opt/relaylab/bin/relaylab-launcher --relaylab /opt/relaylab/bin/relaylab --config /opt/relaylab/config.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/relaylab/data /opt/relaylab/bin
TimeoutStopSec=60
KillMode=mixed

[Install]
WantedBy=multi-user.target
